<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="David_Ahmetovic_projekat.AddGradePage"
             Title="Ocene i Prosek"
             BackgroundColor="#F8F9FA">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Label Text="Unos nove ocene" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#333333" />

            <!-- Izbor predmeta -->
            <Label Text="Izaberite predmet:" FontSize="14" TextColor="#666666"/>
            <Picker x:Name="SubjectPicker" 
                    Title="Izaberi predmet" 
                    ItemDisplayBinding="{Binding Name}" 
                    SelectedIndexChanged="OnSubjectSelected" />

            <!-- Unos ocene -->
            <Entry x:Name="GradeValueEntry" 
                   Placeholder="Ocena (1 - 5)" 
                   Keyboard="Numeric" />

            <!-- Opis ocene -->
            <Entry x:Name="DescriptionEntry" 
                   Placeholder="Opis (npr. Pismeni rad, Kontrolni)" />

            <Button Text="Sačuvaj Ocenu" 
                    Clicked="OnSaveGradeClicked" 
                    BackgroundColor="#512BD4" 
                    TextColor="White" 
                    CornerRadius="10" 
                    HeightRequest="45" />

            <BoxView HeightRequest="1" Color="#CCCCCC" Margin="0,10" />

            <!-- Prikaz Proseka -->
            <Frame BackgroundColor="#E0E0E0" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="AverageLabel" 
                           Text="Prosek ocena: - " 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="#512BD4" />
                </VerticalStackLayout>
            </Frame>

            <!-- Lista Unesenih Ocena -->
            <Label Text="Istorija ocena za izabrani predmet:" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
            <CollectionView x:Name="GradesCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,3" Padding="10" CornerRadius="8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="{Binding Value}" FontSize="18" FontAttributes="Bold" TextColor="#512BD4" Grid.Column="0" Margin="0,0,10,0"/>
                                <Label Text="{Binding Description}" FontSize="14" Grid.Column="1" VerticalOptions="Center"/>
                                <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12" TextColor="Gray" Grid.Column="2" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>