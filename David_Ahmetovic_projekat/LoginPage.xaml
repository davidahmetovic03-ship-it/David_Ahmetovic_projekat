<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="David_Ahmetovic_projekat.LoginPage"
             Title="Prijava"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             Padding="25"
                             VerticalOptions="Center">

            <Label x:Name="TitleLabel"
                   Text="Prijava"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#512BD4" />

            <Label Text="Unesite podatke za pristup nalogu"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <!-- Korisničko ime -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Korisničko ime (Nick):"
                       FontAttributes="Bold" />

                <Entry x:Name="UsernameEntry"
                       Placeholder="Npr. david123"
                       BackgroundColor="White" />
            </VerticalStackLayout>

            <!-- Lozinka -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Lozinka:"
                       FontAttributes="Bold" />

                <Entry x:Name="PasswordEntry"
                       Placeholder="Unesite lozinku"
                       IsPassword="True"
                       BackgroundColor="White" />
            </VerticalStackLayout>

            <!-- Potvrda lozinke (Prikazuje se samo pri registraciji) -->
            <VerticalStackLayout x:Name="ConfirmPasswordContainer"
                                 Spacing="5"
                                 IsVisible="False">

                <Label Text="Potvrdite lozinku:"
                       FontAttributes="Bold" />

                <Entry x:Name="ConfirmPasswordEntry"
                       Placeholder="Ponovo unesite lozinku"
                       IsPassword="True"
                       BackgroundColor="White" />
            </VerticalStackLayout>

            <!-- Dugme za slanje -->
            <Button x:Name="SubmitButton"
                    Text="Prijavi se"
                    Clicked="OnSubmitClicked"
                    Margin="0,10,0,0"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold" />

            <!-- Prebacivanje re režima Prijava / Registracija -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="5">

                <Label x:Name="ToggleQuestionLabel"
                       Text="Nemate nalog?"
                       VerticalOptions="Center"
                       TextColor="#666666" />

                <Button x:Name="ToggleButton"
                       Text="Napravite nalog"
                       Clicked="OnToggleModeClicked"
                       BackgroundColor="Transparent"
                       TextColor="#512BD4"
                       FontAttributes="Bold" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>